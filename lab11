# Задача 2: Добавление новой вершины и соединение её с другими
def add_vertex(target_graph, new_node, neighbors):
    # Если такой вершины еще нет, создаем пустой список
    if new_node not in target_graph:
        target_graph[new_node] = []
    
    for neighbor in neighbors:
        # Добавляем соседа к новой вершине
        if neighbor not in target_graph[new_node]:
            target_graph[new_node].append(neighbor)
        
        # Добавляем новую вершину к соседу (для симметрии)
        if neighbor in target_graph:
            if new_node not in target_graph[neighbor]:
                target_graph[neighbor].append(new_node)
        else:
            # Если соседа не было в графе, создаем его
            target_graph[neighbor] = [new_node]
